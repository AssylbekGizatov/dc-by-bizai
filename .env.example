# Copy to .env for local scripts or Docker Compose. Never commit a real .env.
# Values are literal; local scripts do not evaluate shell commands or ${...}.
APP_MODE=demo
DATABASE_PATH=/tmp/grandmobile/copilot.sqlite3
API_TOKEN=
RULES_PATH=
TAXONOMY_PATH=
ENABLE_GROQ=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=4
GROQ_MAX_RETRIES=1
# Set prices from your actual provider agreement; blank means unknown, not zero.
GROQ_INPUT_USD_PER_MILLION=
GROQ_OUTPUT_USD_PER_MILLION=
# Explicitly opt in only after approval to transmit private content externally.
ALLOW_PRIVATE_DATA_TO_GROQ=false
LOCAL_ENCODER_PATH=
# Trained complaint model from `make train` (private path outside Git); empty = rules only.
CLASSIFIER_PATH=
# Private tickets_train.jsonl.gz: make predict/evaluate train the model first if CLASSIFIER_PATH is unset or missing.
TRAIN_PATH=
LOCAL_MODEL_THREADS=2
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
# Optional encoder CPU thread limits; tune only after measuring your deployment.
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUEST_RATE_PER_MINUTE=120
# The all-in-one Docker image sets FRONTEND_DIST itself.
FRONTEND_DIST=
# Optional: frontend development port. PORT is also accepted by managed previews.
# FRONTEND_PORT=5173
# PORT controls Docker Compose host port and hosted container port; leave unset locally.
# PORT=8000
